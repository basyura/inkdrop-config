{
  "*" : {
    "ctrl-a": "editor:go-line-start",
    "ctrl-e": "editor:go-line-end"
  },

  "body": {
    "f12": "window:toggle-dev-tools",
    "ctrl-r": "narrow-note:open",
    "ctrl-x ctrl-r": "narrow-note:openOnlyInBook",
    "ctrl-x ctrl-n": "narrow-book:open",
    "ctrl-x ctrl-@": "mycmd:select-all-notes",
    "ctrl-x ctrl-x": "mycmd:switch-main",
    "ctrl-x ctrl-i": "mycmd:switch-ikusei",
    "ctrl-x ctrl-z": "mycmd:switch-zcrap",
    "ctrl-:": "mycmd:select-index",
    "ctrl-q": "core:find",
    "ctrl-enter": "mycmd:editor-focus",
    "cmd-s": "view:toggle-side-by-side",
    "cmd-n": false,
    "ctrl-L": "sidetoc:width-decrease",
    "ctrl-K": "sidetoc:width-increase",
    "ctrl-5": "copy-notelink-to-clipboard:copy",
    "ctrl-cmd-r": "window:reload",
    "ctrl-n": "mycmd:noop",
    "ctrl-p": "mycmd:noop",
    "ctrl-w": "mycmd:noop",
    "f11": "mycmd:noop",
    "ctrl-.": "mycmd:open-next-note",
    "ctrl-,": "mycmd:open-prev-note"
  },

  ".cm-editor .cm-scroller": {
    "ctrl-v": "core:paste"
  },

  ".note-list-search-bar input": {
    "ctrl-w": "native!",
    "enter": "mycmd:focus-search"
  },

  ".mde-preview-container": {
    "alt-p": "view:toggle-side-by-side",
    "ctrl-r": "narrow-note:open",
    "ctrl-x ctrl-r": "narrow-note:openOnlyInBook",
    "ctrl-x ctrl-n": "narrow-book:open",
    "ctrl-x ctrl-x": "mycmd:switch-main",
    "ctrl-x ctrl-i": "mycmd:switch-ikusei",
    "ctrl-x ctrl-z": "mycmd:switch-zcrap",
    "ctrl-o": "core:navigate-back",
    "ctrl-i": "core:navigate-forward",
    "ctrl-n": "sidetoc:jump-next",
    "ctrl-p": "sidetoc:jump-prev",
    "ctrl-x ctrl-e": "sidetoc:wraptext-toggle",
    "ctrl-x ctrl-0": "sidetoc:width-reset",
    "ctrl-.": "mycmd:open-next-note",
    "ctrl-,": "mycmd:open-prev-note",
    "ctrl-@": "narrow-tag:open",
    "ctrl-0": "font-size:reset",
    "ctrl-;": "font-size:increase",
    "ctrl--": "font-size:decrease",
    "H": "core:navigate-back",
    "L": "core:navigate-forward",
    "/": "preview-finder:open",
    "n": "preview-finder:next",
    "N": "preview-finder:prev",
    "e": "hitahint:show",
    "ctrl-e": "hitahint:show",
    "ctrl-t": "vtab:add",
    "ctrl-f": "vtab:next",
    "ctrl-b": "vtab:prev",
    "ctrl-s ctrl-s": "mycmd:open-scratch-note",
    "ctrl-s ctrl-i": "mycmd:open-idea-note",
    "space": "view:toggle-preview",
    "ctrl-x ctrl-l": "mycmd:refresh-note",
    "ctrl-1": "bearlike-switch-view:toggle-one",
    "ctrl-2": "bearlike-switch-view:toggle-two",
    "ctrl-3": "bearlike-switch-view:toggle-three"
  },

  ".editor-title-bar-layout input[type='text']": {
    "enter": "mycmd:editor-focus"
  }
}
